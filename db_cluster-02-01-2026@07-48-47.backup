    body text NOT NULL,
    twilio_sid text,
    status text DEFAULT 'pendiente'::text NOT NULL,
    twilio_status text,
    error_code text,
    error_message text,
    sent_at timestamp with time zone,
    delivered_at timestamp with time zone,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.campaign_messages OWNER TO postgres;

--
-- Name: campaigns; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.campaigns (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    nombre text NOT NULL,
    template_id uuid,
    segment_id uuid,
    hospital_id uuid,
    estado text DEFAULT 'Programada'::text NOT NULL,
    fecha_programada date NOT NULL,
    hora_programada time without time zone NOT NULL,
    fecha_envio timestamp with time zone,
    fecha_completado timestamp with time zone,
    destinatarios integer DEFAULT 0,
    enviados integer DEFAULT 0,
    entregados integer DEFAULT 0,
    fallidos integer DEFAULT 0,
    participantes jsonb DEFAULT '{"ninas": 0, "ninos": 0, "hombres": 0, "mujeres": 0}'::jsonb,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    pendientes integer DEFAULT 0 NOT NULL,
    CONSTRAINT campaigns_estado_check CHECK ((estado = ANY (ARRAY['Programada'::text, 'Activa'::text, 'Completada'::text, 'Cancelada'::text])))
);


ALTER TABLE public.campaigns OWNER TO postgres;

