COMMENT ON COLUMN public.sms_logs.status IS 'Estado del SMS: sent (enviado), failed (fallido), delivered (entregado), pending (pendiente)';


--
-- Name: sms_statistics; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.sms_statistics AS
 SELECT c.id AS campaign_id,
    c.nombre AS campaign_name,
    c.hospital_id,
    count(sl.id) AS total_sms,
    count(
        CASE
            WHEN ((sl.status)::text = 'sent'::text) THEN 1
            ELSE NULL::integer
        END) AS sent,
    count(
        CASE
            WHEN ((sl.status)::text = 'delivered'::text) THEN 1
            ELSE NULL::integer
        END) AS delivered,
    count(
        CASE
            WHEN ((sl.status)::text = 'failed'::text) THEN 1
            ELSE NULL::integer
        END) AS failed,
    ((sum(sl.cost_cents))::numeric / 100.0) AS total_cost,
    min(sl.sent_at) AS first_sent,
    max(sl.sent_at) AS last_sent
   FROM (public.campaigns c
     LEFT JOIN public.sms_logs sl ON ((sl.campaign_id = c.id)))
  GROUP BY c.id, c.nombre, c.hospital_id;


ALTER VIEW public.sms_statistics OWNER TO postgres;

