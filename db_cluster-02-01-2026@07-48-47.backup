-- Name: create_interaction_secure(uuid, uuid, text, text, text, text, text, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.create_interaction_secure(p_patient_id uuid, p_hospital_id uuid, p_patient_name text, p_patient_phone text, p_patient_email text, p_tipo text, p_asunto text, p_mensaje text) RETURNS jsonb
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
DECLARE
  v_result JSONB;
BEGIN
  INSERT INTO public.interactions (
    patient_id, 
    hospital_id, 
    patient_name, 
    patient_phone, 
    patient_email, 
    tipo, 
    asunto, 
    mensaje, 
    estado,
    created_at
  ) VALUES (
    p_patient_id, 
    p_hospital_id, 
    p_patient_name, 
    p_patient_phone,
    p_patient_email, 
    p_tipo, 
    p_asunto, 
    p_mensaje, 
    'pendiente',
    NOW()
  )
  RETURNING to_jsonb(interactions.*) INTO v_result;
  
  RETURN v_result;
END;
$$;


ALTER FUNCTION public.create_interaction_secure(p_patient_id uuid, p_hospital_id uuid, p_patient_name text, p_patient_phone text, p_patient_email text, p_tipo text, p_asunto text, p_mensaje text) OWNER TO postgres;

--
-- Name: patients; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.patients (
    patient_id uuid DEFAULT gen_random_uuid() NOT NULL,
    hospital_id uuid,
    name text NOT NULL,
    document character varying,
    phone character varying,
    email character varying,
    birthdate date,
    sex character varying,
    created_at timestamp with time zone DEFAULT now(),
    address character varying,
    city character varying,
    program text,
    password text,
    password_hash text NOT NULL,
    is_active boolean DEFAULT true NOT NULL,
    last_login timestamp with time zone,
    password_changed_at timestamp with time zone,
    must_change_password boolean DEFAULT true NOT NULL,
    sms_opt_in boolean DEFAULT true NOT NULL,
    sms_opt_out_at timestamp with time zone
);


ALTER TABLE public.patients OWNER TO postgres;

--
-- Name: create_patient_secure(uuid, text, text, text, text, date, text, text, text, text, text, boolean); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.create_patient_secure(p_hospital_id uuid, p_email text, p_name text, p_document text, p_phone text, p_birthdate date, p_sex text, p_city text, p_address text, p_program text, p_plain_password text, p_sms_opt_in boolean DEFAULT true) RETURNS public.patients
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public', 'extensions'
    AS $$
DECLARE
  v_existing UUID;
  v_row public.patients;
BEGIN
  SELECT patient_id INTO v_existing
  FROM public.patients
  WHERE hospital_id = p_hospital_id
    AND (
      lower(email) = lower(trim(coalesce(p_email, '')))
      OR document = trim(coalesce(p_document, ''))
    )
  LIMIT 1;

  IF v_existing IS NOT NULL THEN
    RAISE EXCEPTION 'Paciente ya existe (email o documento)';
  END IF;

  INSERT INTO public.patients (
    hospital_id,
    email,
    name,
    document,
    phone,
    birthdate,
    sex,
    city,
    address,
    program,
    password_hash,
    must_change_password,
    sms_opt_in,
    sms_opt_out_at
  ) VALUES (
    p_hospital_id,
    lower(trim(p_email)),
    trim(p_name),
    trim(p_document),
    p_phone,
    p_birthdate,
    p_sex,
    p_city,
    p_address,
    p_program,
    crypt(coalesce(p_plain_password, ''), gen_salt('bf', 10)),
    TRUE,
    coalesce(p_sms_opt_in, TRUE),
    CASE WHEN coalesce(p_sms_opt_in, TRUE) THEN NULL ELSE now() END
  )
  RETURNING * INTO v_row;

  RETURN v_row;
END;
$$;


ALTER FUNCTION public.create_patient_secure(p_hospital_id uuid, p_email text, p_name text, p_document text, p_phone text, p_birthdate date, p_sex text, p_city text, p_address text, p_program text, p_plain_password text, p_sms_opt_in boolean) OWNER TO postgres;

--
-- Name: create_patient_with_auth(uuid, character varying, character varying, character varying, character varying, date, character varying, text, character varying, character varying, character varying, character varying, character varying); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.create_patient_with_auth(p_hospital_id uuid, p_document character varying, p_name character varying, p_email character varying, p_phone character varying, p_birth_date date, p_gender character varying, p_address text DEFAULT NULL::text, p_city character varying DEFAULT NULL::character varying, p_emergency_contact character varying DEFAULT NULL::character varying, p_emergency_phone character varying DEFAULT NULL::character varying, p_blood_type character varying DEFAULT NULL::character varying, p_password character varying DEFAULT NULL::character varying) RETURNS uuid
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_patient_id UUID;
  v_hashed_password TEXT;
  v_final_password VARCHAR(100);
BEGIN
  -- Generar ID para el paciente
  v_patient_id := gen_random_uuid();
  
  -- Determinar la contraseña (documento si no se proporciona)
  v_final_password := COALESCE(p_password, p_document);
  
  -- Hash de la contraseña
  v_hashed_password := crypt(v_final_password, gen_salt('bf'));
  
  -- 1. Crear credenciales en users
  INSERT INTO users (
    user_id,
    email,
    password,
    role,
    is_active,
    created_at
  ) VALUES (
    v_patient_id,
    p_email,
    v_hashed_password,
    'patient',
    true,
    NOW()
  );
  
  -- 2. Crear el paciente
  INSERT INTO patients (
    patient_id,
    hospital_id,
    document,
    name,
    email,
    phone,
    birth_date,
    gender,
    address,
    city,
    emergency_contact,
    emergency_phone,
    blood_type,
    created_at
  ) VALUES (
    v_patient_id,
    p_hospital_id,
    p_document,
    p_name,
    p_email,
    p_phone,
    p_birth_date,
    p_gender,
    p_address,
    p_city,
    p_emergency_contact,
    p_emergency_phone,
    p_blood_type,
    NOW()
  );
  
  RAISE NOTICE '';
  RAISE NOTICE '✅ Paciente creado exitosamente';
  RAISE NOTICE '   👤 Nombre: %', p_name;
  RAISE NOTICE '   📄 Documento: %', p_document;
  RAISE NOTICE '   📧 Email: %', p_email;
  RAISE NOTICE '   🔑 Contraseña: %', v_final_password;
  RAISE NOTICE '';
  
  RETURN v_patient_id;
END;
$$;


ALTER FUNCTION public.create_patient_with_auth(p_hospital_id uuid, p_document character varying, p_name character varying, p_email character varying, p_phone character varying, p_birth_date date, p_gender character varying, p_address text, p_city character varying, p_emergency_contact character varying, p_emergency_phone character varying, p_blood_type character varying, p_password character varying) OWNER TO postgres;

--
-- Name: doctor_login(text, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.doctor_login(p_email text, p_password text) RETURNS TABLE(success boolean, message text, doctor_id uuid, doctor_email text, doctor_name text, doctor_specialty text, hospital_id uuid, hospital_name text)
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
DECLARE
  d RECORD;
BEGIN
  SELECT
    s.doctor_id,
    s.doctor_email,
    s.doctor_name,
    s.doctor_specialty,
    s.hospital_id,
    s.doctor_password,
    s.is_active,
    h.name AS hospital_name
  INTO d
  FROM public.staff s
  LEFT JOIN public.hospitals h ON h.hospital_id = s.hospital_id
  WHERE lower(s.doctor_email) = lower(trim(coalesce(p_email, '')))
  LIMIT 1;

  IF d.doctor_id IS NULL THEN
    RETURN QUERY SELECT FALSE, 'Doctor no encontrado', NULL::UUID, NULL::TEXT, NULL::TEXT, NULL::TEXT, NULL::UUID, NULL::TEXT;
    RETURN;
  END IF;

  IF NOT d.is_active THEN
    RETURN QUERY SELECT FALSE, 'Doctor inactivo', NULL::UUID, NULL::TEXT, NULL::TEXT, NULL::TEXT, NULL::UUID, NULL::TEXT;
    RETURN;
  END IF;

  IF coalesce(d.doctor_password, '') <> coalesce(p_password, '') THEN
    RETURN QUERY SELECT FALSE, 'Contraseña incorrecta', NULL::UUID, NULL::TEXT, NULL::TEXT, NULL::TEXT, NULL::UUID, NULL::TEXT;
    RETURN;
  END IF;

  UPDATE public.staff s
  SET last_login_at = now(), updated_at = now()
  WHERE s.doctor_id = d.doctor_id;

  RETURN QUERY SELECT TRUE, 'OK', d.doctor_id, d.doctor_email, d.doctor_name, d.doctor_specialty, d.hospital_id, d.hospital_name;
END;
$$;


ALTER FUNCTION public.doctor_login(p_email text, p_password text) OWNER TO postgres;

--
-- Name: get_campaign_sms_stats(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_campaign_sms_stats(campaign_uuid uuid) RETURNS TABLE(total_sent bigint, total_delivered bigint, total_failed bigint, total_cost numeric, delivery_rate numeric)
    LANGUAGE plpgsql
    AS $$
BEGIN
  RETURN QUERY
  SELECT 
    COUNT(CASE WHEN status IN ('sent', 'delivered') THEN 1 END) as total_sent,
    COUNT(CASE WHEN status = 'delivered' THEN 1 END) as total_delivered,
    COUNT(CASE WHEN status = 'failed' THEN 1 END) as total_failed,
    COALESCE(SUM(cost_cents) / 100.0, 0) as total_cost,
    CASE 
      WHEN COUNT(*) > 0 THEN 
        ROUND((COUNT(CASE WHEN status = 'delivered' THEN 1 END)::NUMERIC / COUNT(*)::NUMERIC) * 100, 2)
      ELSE 0
    END as delivery_rate
  FROM sms_logs
  WHERE campaign_id = campaign_uuid;
END;
$$;


ALTER FUNCTION public.get_campaign_sms_stats(campaign_uuid uuid) OWNER TO postgres;

--
-- Name: get_doctor_appointments_month(uuid, date); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_doctor_appointments_month(p_doctor_id uuid, p_month_start date) RETURNS TABLE(id uuid, start_at timestamp with time zone, end_at timestamp with time zone, status text, patient_id uuid, patient_name text)
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
DECLARE
  start_ts TIMESTAMPTZ;
  end_ts TIMESTAMPTZ;
BEGIN
  start_ts := date_trunc('month', p_month_start::timestamptz);
  end_ts := (start_ts + interval '1 month');

  RETURN QUERY
  SELECT
    a.id,
    a.start_at,
    a.end_at,
    a.status,
    a.patient_id,
    p.name AS patient_name
  FROM public.appointments a
  JOIN public.patients p ON p.patient_id = a.patient_id
  WHERE a.doctor_id = p_doctor_id
    AND a.start_at >= start_ts
    AND a.start_at < end_ts
  ORDER BY a.start_at;
END;
$$;


ALTER FUNCTION public.get_doctor_appointments_month(p_doctor_id uuid, p_month_start date) OWNER TO postgres;

--
-- Name: get_doctor_booked_slots_month(uuid, date); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_doctor_booked_slots_month(p_doctor_id uuid, p_month_start date) RETURNS TABLE(start_at timestamp with time zone, status text)
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
DECLARE
  start_ts TIMESTAMPTZ;
  end_ts TIMESTAMPTZ;
BEGIN
  start_ts := date_trunc('month', p_month_start::timestamptz);
  end_ts := (start_ts + interval '1 month');

  RETURN QUERY
  SELECT a.start_at, a.status
  FROM public.appointments a
  WHERE a.doctor_id = p_doctor_id
    AND a.start_at >= start_ts
    AND a.start_at < end_ts
    AND a.status <> 'cancelada'
  ORDER BY a.start_at;
END;
$$;


ALTER FUNCTION public.get_doctor_booked_slots_month(p_doctor_id uuid, p_month_start date) OWNER TO postgres;

--
-- Name: get_doctor_schedule(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_doctor_schedule(p_doctor_id uuid) RETURNS json
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
DECLARE
  s public.doctor_schedules;
  result JSON;
BEGIN
  SELECT * INTO s
  FROM public.doctor_schedules
  WHERE doctor_id = p_doctor_id
  LIMIT 1;

  IF s.doctor_id IS NULL THEN
    SELECT json_build_object(
      'doctor_id', p_doctor_id,
      'timezone', 'America/Bogota',
      'slot_minutes', 30,
      'workdays', ARRAY[1,2,3,4,5],
      'morning_start', '05:00',
      'morning_end', '11:00',
      'afternoon_start', '14:00',
      'afternoon_end', '20:00'
    ) INTO result;
    RETURN result;
  END IF;

  SELECT json_build_object(
    'doctor_id', s.doctor_id,
    'hospital_id', s.hospital_id,
    'timezone', s.timezone,
    'slot_minutes', s.slot_minutes,
    'workdays', s.workdays,
    'morning_start', to_char(s.morning_start, 'HH24:MI'),
    'morning_end', to_char(s.morning_end, 'HH24:MI'),
    'afternoon_start', to_char(s.afternoon_start, 'HH24:MI'),
    'afternoon_end', to_char(s.afternoon_end, 'HH24:MI')
  ) INTO result;

  RETURN result;
END;
$$;


ALTER FUNCTION public.get_doctor_schedule(p_doctor_id uuid) OWNER TO postgres;

--
-- Name: interactions; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.interactions (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    patient_id uuid,
    hospital_id uuid,
    patient_name character varying(255) NOT NULL,
    patient_phone character varying(20),
    patient_email character varying(255),
    tipo character varying(50) NOT NULL,
    asunto character varying(255) NOT NULL,
    mensaje text NOT NULL,
    estado character varying(50) DEFAULT 'pendiente'::character varying,
    prioridad integer DEFAULT 2,
    respuesta text,
    respondido_por uuid,
    respondido_en timestamp with time zone,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now(),
    CONSTRAINT interactions_estado_check CHECK (((estado)::text = ANY ((ARRAY['pendiente'::character varying, 'en_proceso'::character varying, 'resuelto'::character varying, 'cerrado'::character varying])::text[]))),
    CONSTRAINT interactions_prioridad_check CHECK ((prioridad = ANY (ARRAY[1, 2, 3]))),
    CONSTRAINT interactions_tipo_check CHECK (((tipo)::text = ANY ((ARRAY['urgencia'::character varying, 'pqr'::character varying, 'reporte_tecnico'::character varying])::text[])))
);


ALTER TABLE public.interactions OWNER TO postgres;

--
-- Name: TABLE interactions; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON TABLE public.interactions IS 'Tabla para gestionar interacciones bidireccionales entre pacientes y hospitales';


--
-- Name: COLUMN interactions.tipo; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.interactions.tipo IS 'Tipo de interacción: urgencia, pqr (peticiones/quejas/reclamos), reporte_tecnico';


--
-- Name: COLUMN interactions.estado; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.interactions.estado IS 'Estado: pendiente, en_proceso, resuelto, cerrado';


--
-- Name: COLUMN interactions.prioridad; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON COLUMN public.interactions.prioridad IS 'Prioridad: 1=Alta, 2=Media, 3=Baja';


--
-- Name: get_my_interactions(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_my_interactions() RETURNS SETOF public.interactions
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
BEGIN
  RETURN QUERY
  SELECT *
  FROM public.interactions
  WHERE patient_id = auth.uid()
  ORDER BY created_at DESC;
END;
$$;


ALTER FUNCTION public.get_my_interactions() OWNER TO postgres;

--
-- Name: get_patient_appointments_month(uuid, date); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_patient_appointments_month(p_patient_id uuid, p_month_start date) RETURNS TABLE(id uuid, start_at timestamp with time zone, end_at timestamp with time zone, status text, doctor_id uuid, doctor_name text, doctor_specialty text)
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
DECLARE
  start_ts TIMESTAMPTZ;
  end_ts TIMESTAMPTZ;
BEGIN
  start_ts := date_trunc('month', p_month_start::timestamptz);
  end_ts := (start_ts + interval '1 month');

  RETURN QUERY
  SELECT
    a.id,
    a.start_at,
    a.end_at,
    a.status,
    a.doctor_id,
    s.doctor_name,
    s.doctor_specialty
  FROM public.appointments a
  JOIN public.staff s ON s.doctor_id = a.doctor_id
  WHERE a.patient_id = p_patient_id
    AND a.start_at >= start_ts
    AND a.start_at < end_ts
  ORDER BY a.start_at;
END;
$$;


ALTER FUNCTION public.get_patient_appointments_month(p_patient_id uuid, p_month_start date) OWNER TO postgres;

--
-- Name: get_patient_interactions(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_patient_interactions(p_patient_id uuid) RETURNS json
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
DECLARE
  result JSON;
BEGIN
  SELECT json_agg(t) INTO result
  FROM (
    SELECT 
      i.*, 
      h.name as hospital_name
    FROM public.interactions i
    LEFT JOIN public.hospitals h ON i.hospital_id = h.hospital_id
    WHERE i.patient_id = p_patient_id
    ORDER BY i.created_at DESC
  ) t;
  
  -- Return empty array if null (instead of null)
  RETURN COALESCE(result, '[]'::json);
END;
$$;


ALTER FUNCTION public.get_patient_interactions(p_patient_id uuid) OWNER TO postgres;

--
-- Name: get_user_email(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_user_email() RETURNS text
    LANGUAGE sql STABLE SECURITY DEFINER
    AS $$
  SELECT email 
  FROM auth.users 
  WHERE id = auth.uid();
$$;


ALTER FUNCTION public.get_user_email() OWNER TO postgres;

--
-- Name: get_user_role(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.get_user_role() RETURNS text
    LANGUAGE sql STABLE SECURITY DEFINER
    AS $$
  SELECT raw_user_meta_data->>'role' 
  FROM auth.users 
  WHERE id = auth.uid();
$$;


ALTER FUNCTION public.get_user_role() OWNER TO postgres;

--
-- Name: handle_new_hospital_user(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.handle_new_hospital_user() RETURNS trigger
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
BEGIN
  -- Si el email existe en la tabla hospitals, asignar rol hospital_admin
  IF EXISTS (SELECT 1 FROM public.hospitals WHERE email = NEW.email) THEN
    UPDATE auth.users
    SET raw_user_meta_data = 
      COALESCE(raw_user_meta_data, '{}'::jsonb) || 
      '{"role": "hospital_admin"}'::jsonb
    WHERE id = NEW.id;
  END IF;
  
  RETURN NEW;
END;
$$;


ALTER FUNCTION public.handle_new_hospital_user() OWNER TO postgres;

--
-- Name: initialize_patient_vital_signs(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.initialize_patient_vital_signs(p_patient_id uuid) RETURNS void
    LANGUAGE plpgsql SECURITY DEFINER
    AS $$
BEGIN
  -- Solo crear registro si NO existe uno para este paciente
  IF NOT EXISTS (
    SELECT 1 
    FROM signos_vitales 
    WHERE paciente_id = p_patient_id
  ) THEN
    INSERT INTO signos_vitales (
      paciente_id,
      fecha,
      temperatura,
      presion_sistolica,
      presion_diastolica,
      ritmo_cardiaco,
      glucometria,
      peso
    ) VALUES (
      p_patient_id,
      NOW(),
      0,
      0,
      0,
      0,
      0,
      NULL
    );
    
    RAISE NOTICE 'Registro inicial de signos vitales creado para paciente %', p_patient_id;
  ELSE
    RAISE NOTICE 'El paciente % ya tiene registros de signos vitales', p_patient_id;
  END IF;
END;
$$;


ALTER FUNCTION public.initialize_patient_vital_signs(p_patient_id uuid) OWNER TO postgres;

--
-- Name: is_admin_user(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.is_admin_user() RETURNS boolean
    LANGUAGE sql STABLE
    AS $$
  SELECT public.jwt_role() IN ('super_admin', 'operator', 'hospital_admin')
     OR EXISTS (SELECT 1 FROM public.hospitals h WHERE h.hospital_id = auth.uid());
$$;


ALTER FUNCTION public.is_admin_user() OWNER TO postgres;

--
-- Name: jwt_role(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.jwt_role() RETURNS text
    LANGUAGE sql STABLE
    AS $$
  SELECT COALESCE(
    auth.jwt() ->> 'role',
    auth.jwt() -> 'user_metadata' ->> 'role',
    auth.jwt() -> 'app_metadata' ->> 'role',
    ''
  );
$$;


ALTER FUNCTION public.jwt_role() OWNER TO postgres;

--
-- Name: patient_change_password(uuid, text, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.patient_change_password(p_patient_id uuid, p_current_password text, p_new_password text) RETURNS TABLE(success boolean, message text)
    LANGUAGE plpgsql SECURITY DEFINER
    AS $_$
DECLARE
  v_stored_password text;
  v_password_matches boolean := false;
BEGIN
  -- Obtener la contraseña actual
  SELECT password INTO v_stored_password
  FROM patients
  WHERE patient_id = p_patient_id;
  
  -- Verificar si el paciente existe
  IF v_stored_password IS NULL THEN
    RETURN QUERY SELECT 
      false,
      'Paciente no encontrado'::text;
    RETURN;
  END IF;
  
  -- Verificar la contraseña actual
  IF LENGTH(v_stored_password) = 60 AND v_stored_password LIKE '$2%' THEN
    -- Contraseña hasheada
    v_password_matches := (crypt(p_current_password, v_stored_password) = v_stored_password);
  ELSE
    -- Contraseña en texto plano
    v_password_matches := (TRIM(v_stored_password) = TRIM(p_current_password));
  END IF;
  
  -- Si la contraseña actual no coincide, rechazar
  IF NOT v_password_matches THEN
    RETURN QUERY SELECT 
      false,
      'Contraseña actual incorrecta'::text;
    RETURN;
  END IF;
  
  -- Actualizar con la nueva contraseña (en texto plano por ahora)
  UPDATE patients
  SET password = p_new_password
  WHERE patient_id = p_patient_id;
  
  RETURN QUERY SELECT 
    true,
    'Contraseña actualizada exitosamente'::text;
  
END;
$_$;


ALTER FUNCTION public.patient_change_password(p_patient_id uuid, p_current_password text, p_new_password text) OWNER TO postgres;

--
-- Name: patient_login(text, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.patient_login(p_identifier text, p_password text) RETURNS TABLE(success boolean, message text, patient_id uuid, email text, name text, document text)
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public', 'extensions'
    AS $$
DECLARE
  v_identifier TEXT;
  v_patient_id UUID;
  v_email TEXT;
  v_name TEXT;
  v_document TEXT;
  v_password_hash TEXT;
BEGIN
  v_identifier := trim(coalesce(p_identifier, ''));

  SELECT
    pa.patient_id,
    pa.email,
    pa.name,
    pa.document,
    pa.password_hash
  INTO
    v_patient_id,
    v_email,
    v_name,
    v_document,
    v_password_hash
  FROM public.patients pa
  WHERE lower(pa.email) = lower(v_identifier)
     OR pa.document = v_identifier
  LIMIT 1;

  IF v_patient_id IS NULL THEN
    RETURN QUERY SELECT FALSE, 'Paciente no encontrado', NULL::UUID, NULL::TEXT, NULL::TEXT, NULL::TEXT;
    RETURN;
  END IF;

  IF coalesce(v_password_hash, '') = '' THEN
    RETURN QUERY SELECT FALSE, 'Paciente sin contraseña asignada', v_patient_id, v_email, v_name, v_document;
    RETURN;
  END IF;

  IF crypt(coalesce(p_password, ''), v_password_hash) <> v_password_hash THEN
    RETURN QUERY SELECT FALSE, 'Contraseña incorrecta', v_patient_id, v_email, v_name, v_document;
    RETURN;
  END IF;

  RETURN QUERY SELECT TRUE, 'OK', v_patient_id, v_email, v_name, v_document;
END;
$$;


ALTER FUNCTION public.patient_login(p_identifier text, p_password text) OWNER TO postgres;

--
-- Name: recompute_campaign_counts(uuid); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.recompute_campaign_counts(p_campaign_id uuid) RETURNS void
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
DECLARE
  v_enviados INT;
  v_entregados INT;
  v_fallidos INT;
  v_pendientes INT;
BEGIN
  SELECT
    COUNT(*) FILTER (WHERE status IN ('enviado', 'entregado', 'fallido'))::INT,
    COUNT(*) FILTER (WHERE status = 'entregado')::INT,
    COUNT(*) FILTER (WHERE status = 'fallido')::INT,
    COUNT(*) FILTER (WHERE status IN ('pendiente', 'enviado'))::INT
  INTO v_enviados, v_entregados, v_fallidos, v_pendientes
  FROM public.campaign_messages
  WHERE campaign_id = p_campaign_id;

  UPDATE public.campaigns
  SET
    enviados = v_enviados,
    entregados = v_entregados,
    fallidos = v_fallidos,
    pendientes = v_pendientes,
    estado = CASE
      WHEN v_pendientes = 0 AND (v_enviados + v_fallidos + v_entregados) > 0 THEN 'Completada'
      ELSE estado
    END,
    fecha_completado = CASE
      WHEN v_pendientes = 0 AND (v_enviados + v_fallidos + v_entregados) > 0 AND fecha_completado IS NULL THEN now()
      ELSE fecha_completado
    END
  WHERE id = p_campaign_id;
END;
$$;


ALTER FUNCTION public.recompute_campaign_counts(p_campaign_id uuid) OWNER TO postgres;

--
-- Name: reset_patient_password(uuid, character varying); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.reset_patient_password(p_patient_id uuid, p_new_password character varying DEFAULT NULL::character varying) RETURNS TABLE(success boolean, new_password character varying, message character varying)
    LANGUAGE plpgsql
    AS $$
DECLARE
  v_patient RECORD;
  v_hashed_password TEXT;
  v_final_password VARCHAR(100);
BEGIN
  -- Buscar paciente
  SELECT * INTO v_patient
  FROM patients
  WHERE patient_id = p_patient_id;
  
  IF v_patient IS NULL THEN
    RETURN QUERY SELECT false, NULL::VARCHAR(100), 'Paciente no encontrado'::VARCHAR(200);
    RETURN;
  END IF;
  
  -- Si no se proporciona password, usar el documento
  v_final_password := COALESCE(p_new_password, v_patient.document);
  v_hashed_password := crypt(v_final_password, gen_salt('bf'));
  
  -- Actualizar contraseña
  UPDATE users
  SET password = v_hashed_password,
      password_changed_at = NOW()
  WHERE user_id = p_patient_id;
  
  RETURN QUERY SELECT 
    true, 
    v_final_password::VARCHAR(100), 
    'Contraseña reseteada exitosamente'::VARCHAR(200);
END;
$$;


ALTER FUNCTION public.reset_patient_password(p_patient_id uuid, p_new_password character varying) OWNER TO postgres;

--
-- Name: set_default_password(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.set_default_password() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
  -- Si no se proporciona contraseña, usar el documento
  IF NEW.password IS NULL OR TRIM(NEW.password) = '' THEN
    IF NEW.document IS NOT NULL AND TRIM(NEW.document) != '' THEN
      NEW.password := NEW.document;
      RAISE NOTICE 'Contraseña predeterminada asignada para paciente: %', NEW.name;
    END IF;
  END IF;
  
  RETURN NEW;
END;
$$;


ALTER FUNCTION public.set_default_password() OWNER TO postgres;

--
-- Name: update_appointment_status_for_doctor(uuid, uuid, text); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.update_appointment_status_for_doctor(p_doctor_id uuid, p_appointment_id uuid, p_new_status text) RETURNS public.appointments
    LANGUAGE plpgsql SECURITY DEFINER
    SET search_path TO 'public'
    AS $$
DECLARE
  v_row public.appointments;
BEGIN
  SELECT * INTO v_row
  FROM public.appointments
  WHERE id = p_appointment_id
  LIMIT 1;

  IF v_row.id IS NULL THEN
    RAISE EXCEPTION 'Cita no encontrada';
  END IF;

  IF v_row.doctor_id IS DISTINCT FROM p_doctor_id THEN
    RAISE EXCEPTION 'No autorizado para gestionar esta cita';
  END IF;

  IF p_new_status NOT IN ('pendiente', 'confirmada', 'cancelada') THEN
    RAISE EXCEPTION 'Estado inválido';
  END IF;

  UPDATE public.appointments
  SET status = p_new_status, updated_at = now()
  WHERE id = p_appointment_id
  RETURNING * INTO v_row;

  RETURN v_row;
END;
$$;


ALTER FUNCTION public.update_appointment_status_for_doctor(p_doctor_id uuid, p_appointment_id uuid, p_new_status text) OWNER TO postgres;

