--
-- Name: appointments Admin can manage appointments; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Admin can manage appointments" ON public.appointments TO authenticated USING ((public.is_admin_user() AND ((hospital_id IS NULL) OR (hospital_id = auth.uid())))) WITH CHECK ((public.is_admin_user() AND ((hospital_id IS NULL) OR (hospital_id = auth.uid()))));


--
-- Name: doctor_schedules Admin can manage doctor schedules; Type: POLICY; Schema: public; Owner: postgres
