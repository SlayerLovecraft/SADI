--
-- Name: interactions hospitals_can_update_interactions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY hospitals_can_update_interactions ON public.interactions FOR UPDATE TO authenticated USING ((hospital_id IN ( SELECT hospitals.hospital_id
   FROM public.hospitals
  WHERE ((hospitals.email)::text = (auth.jwt() ->> 'email'::text))))) WITH CHECK ((hospital_id IN ( SELECT hospitals.hospital_id
   FROM public.hospitals
  WHERE ((hospitals.email)::text = (auth.jwt() ->> 'email'::text)))));


