--
-- Name: interactions patients_can_create_interactions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY patients_can_create_interactions ON public.interactions FOR INSERT WITH CHECK (((patient_id IN ( SELECT patients.patient_id
   FROM public.patients)) AND (hospital_id IN ( SELECT hospitals.hospital_id
   FROM public.hospitals)) AND ((tipo)::text = ANY ((ARRAY['urgencia'::character varying, 'reporte_tecnico'::character varying, 'pqr'::character varying])::text[])) AND ((estado)::text = 'pendiente'::text)));


--
-- Name: interactions patients_can_view_own_interactions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY patients_can_view_own_interactions ON public.interactions FOR SELECT USING ((patient_id IN ( SELECT patients.patient_id
   FROM public.patients
  WHERE (patients.patient_id = patients.patient_id))));


