    patient_id uuid NOT NULL,
    record_date date DEFAULT CURRENT_DATE NOT NULL,
    record_type text NOT NULL,
    doctor_name text,
    notes text,
    attachment_url text,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    doctor_id uuid
);


ALTER TABLE public.clinical_records OWNER TO postgres;

--
-- Name: doctor_schedules; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.doctor_schedules (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    doctor_id uuid NOT NULL,
    hospital_id uuid,
    timezone text DEFAULT 'America/Bogota'::text NOT NULL,
    slot_minutes integer DEFAULT 30 NOT NULL,
    workdays smallint[] DEFAULT ARRAY[1, 2, 3, 4, 5] NOT NULL,
    morning_start time without time zone DEFAULT '05:00:00'::time without time zone NOT NULL,
    morning_end time without time zone DEFAULT '11:00:00'::time without time zone NOT NULL,
    afternoon_start time without time zone DEFAULT '14:00:00'::time without time zone NOT NULL,
    afternoon_end time without time zone DEFAULT '20:00:00'::time without time zone NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL,
    CONSTRAINT doctor_schedules_afternoon_chk CHECK ((afternoon_start < afternoon_end)),
    CONSTRAINT doctor_schedules_morning_chk CHECK ((morning_start < morning_end)),
    CONSTRAINT doctor_schedules_slot_minutes_chk CHECK (((slot_minutes >= 5) AND (slot_minutes <= 180))),
    CONSTRAINT doctor_schedules_windows_no_overlap_chk CHECK ((morning_end <= afternoon_start)),
    CONSTRAINT doctor_schedules_workdays_chk CHECK (((array_length(workdays, 1) IS NOT NULL) AND (workdays <@ ARRAY[(1)::smallint, (2)::smallint, (3)::smallint, (4)::smallint, (5)::smallint, (6)::smallint, (7)::smallint])))
);


ALTER TABLE public.doctor_schedules OWNER TO postgres;

