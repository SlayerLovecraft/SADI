-- Name: staff; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.staff (
    doctor_id uuid DEFAULT gen_random_uuid() NOT NULL,
    doctor_name text,
    doctor_email text NOT NULL,
    doctor_password text NOT NULL,
    doctor_specialty text NOT NULL,
    hospital_id uuid,
    is_active boolean DEFAULT true NOT NULL,
    must_change_password boolean DEFAULT false NOT NULL,
    last_login_at timestamp with time zone,
    metadata jsonb DEFAULT '{}'::jsonb NOT NULL,
    created_at timestamp with time zone DEFAULT now() NOT NULL,
    updated_at timestamp with time zone DEFAULT now() NOT NULL
);


ALTER TABLE public.staff OWNER TO postgres;

--
-- Name: templates; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.templates (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    nombre text NOT NULL,
    mensaje text NOT NULL,
    categoria text DEFAULT 'General'::text,
    variables text[] DEFAULT '{}'::text[],
    hospital_id uuid,
    created_at timestamp with time zone DEFAULT now(),
    updated_at timestamp with time zone DEFAULT now()
);


ALTER TABLE public.templates OWNER TO postgres;

--
-- Name: users; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.users (
    user_id uuid NOT NULL,
    email character varying(100) NOT NULL,
    password text NOT NULL,
    role character varying(20) NOT NULL,
    is_active boolean DEFAULT true,
    last_login timestamp without time zone,
    password_changed_at timestamp without time zone,
    created_at timestamp without time zone DEFAULT now(),
    updated_at timestamp without time zone DEFAULT now(),
    CONSTRAINT users_role_check CHECK (((role)::text = ANY ((ARRAY['admin'::character varying, 'doctor'::character varying, 'patient'::character varying, 'hospital_admin'::character varying])::text[])))
);


ALTER TABLE public.users OWNER TO postgres;

--
-- Name: v_patients_auth_status; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.v_patients_auth_status AS
 SELECT p.patient_id,
    p.document,
    p.name,
    p.email,
    p.phone,
        CASE
            WHEN (u.user_id IS NOT NULL) THEN '✓ Con credenciales'::text
            ELSE '✗ Sin credenciales'::text
        END AS auth_status,
    u.is_active,
    u.last_login,
    u.password_changed_at,
    p.created_at
   FROM (public.patients p
     LEFT JOIN public.users u ON ((u.user_id = p.patient_id)))
  ORDER BY p.created_at DESC;


ALTER VIEW public.v_patients_auth_status OWNER TO postgres;

