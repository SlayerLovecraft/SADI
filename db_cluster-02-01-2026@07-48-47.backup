--
-- Name: signos_vitales Hospitales pueden ver signos vitales de sus pacientes; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Hospitales pueden ver signos vitales de sus pacientes" ON public.signos_vitales FOR SELECT USING ((EXISTS ( SELECT 1
   FROM (public.patients p
     JOIN public.hospitals h ON ((p.hospital_id = h.hospital_id)))
  WHERE ((p.patient_id = signos_vitales.paciente_id) AND ((h.email)::text = ((current_setting('request.jwt.claims'::text, true))::json ->> 'email'::text))))));


--
-- Name: campaigns Hospitales pueden ver sus campañas; Type: POLICY; Schema: public; Owner: postgres
