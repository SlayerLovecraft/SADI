{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm --prefix _react_legacy/SADI_React-Node.js install",
  "buildCommand": "npm --prefix _react_legacy/SADI_React-Node.js run build",
  "outputDirectory": "_react_legacy/SADI_React-Node.js/dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
